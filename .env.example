# Copy this file to `.env` and fill in your own keys.
# Every value below is YOURS — never reuse someone else's keys.

# 1. Google Gemini API key (free at https://aistudio.google.com/apikey)
#    Used for embeddings (3072-dim) AND grounded answer generation.
GEMINI_API_KEY=your_gemini_key_here

# 2. Firecrawl API key (free tier at https://firecrawl.dev)
#    Used to crawl your website into text.
FIRECRAWL_API_KEY=your_firecrawl_key_here

# 3. The website you want the AI bot to know about.
#    This is the URL the pipeline crawls. Change it to YOUR site.
SITE_URL=https://your-website.com/

# 4. Path to YOUR website's git clone (the repo that will host api/ask.js).
#    Used by `python run_pipeline.py --sync-live` to write api/vectors.json and push.
ADCETPORTAL_REPO=C:\path\to\your-website-repo
